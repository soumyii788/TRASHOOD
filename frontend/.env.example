# Copy to frontend/.env (Vite).

VITE_API_BASE_URL=http://localhost:8000

# Google OAuth client ID (Google Cloud Console -> APIs & Services -> Credentials).
# Add this app's origin (e.g. http://localhost:5173) as an Authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Apple "Services ID" (Apple Developer -> Identifiers -> Services ID, with
# "Sign In with Apple" enabled). Register this app's origin as a Return URL.
VITE_APPLE_CLIENT_ID=com.yourapp.web
