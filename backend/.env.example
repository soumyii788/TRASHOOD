# Copy to backend/.env (loaded automatically via python-dotenv).

SECRET_KEY=change-me-in-production

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Apple Sign In (developer.apple.com -> Certificates, Identifiers & Profiles)
# Use the "Services ID" identifier for the web flow.
APPLE_CLIENT_ID=com.yourapp.web
